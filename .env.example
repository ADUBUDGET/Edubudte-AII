# Copy this file to .env and fill in your real keys.
# Never commit your real .env file.

# Neon Postgres connection string (from your Neon project dashboard)
# Looks like: postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Groq API key (from console.groq.com)
GROQ_API_KEY=

# Groq model to use for ranking/recommendations.
# Groq deprecates models periodically - check console.groq.com/docs/models
# if this one stops working and swap it here.
GROQ_MODEL=openai/gpt-oss-120b

# SerpAPI key (from serpapi.com) - used for real Google Shopping results
SERPAPI_KEY=

# OpenRouteService API key - FREE, no credit card required.
# Sign up at openrouteservice.org -> Dashboard -> Request a token (Standard type)
ORS_API_KEY=

# Secret used to sign login session tokens (JWT). Generate a random one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the server runs on
PORT=3000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EduBudget AI <add budget app email here>
APP_URL=http://localhost:3000
